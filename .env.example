# Runtime
ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost
REFRESH_COOKIE_SECURE=false
VITE_BACKEND_URL=http://localhost:8000

# Database (Compose supplies its own internal URL by default)
MONGO_URL=mongodb://localhost:27017
DB_NAME=accessibility_scanner

# Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Email
SENDGRID_API_KEY=
SENDER_EMAIL=noreply@auditly.com

# Optional S3-compatible screenshot evidence storage
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_PREFIX=auditly-evidence
S3_ENDPOINT_URL=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional external accessibility APIs
WAVE_API_KEY=
EQUALWEB_API_KEY=
ACCESSIBE_API_KEY=

# Scanner network limits
SCAN_ALLOWED_PORTS=80,443
SCAN_NAVIGATION_TIMEOUT_MS=30000
